{
  "name": "tcc-agendamento-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend da plataforma profissional de agendamento online Agendai.",
  "main": "src/server.js",
  "scripts": {
    "db:migrate": "node scripts/migrate.js",
    "privacy:anonymize": "node scripts/privacy-anonymize.js",
    "privacy:retention": "node scripts/privacy-retention.js",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.22.0"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
