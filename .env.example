# Backend
PORT=3001
NODE_ENV=development
TZ=America/Sao_Paulo
TRUST_PROXY_HOPS=0
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=troque_este_valor_por_um_segredo_seguro
JWT_EXPIRES_IN=1d
UPLOAD_DIR=

# PostgreSQL / Supabase
DATABASE_URL=
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_CA=

# Testes PostgreSQL destrutivos (somente banco local e descartável)
# Não carregados automaticamente; exporte RUN_POSTGRES_INTEGRATION=1 somente
# durante uma execução deliberada. Qualquer outro valor explícito é recusado.
RUN_POSTGRES_INTEGRATION=
# Somente no serviço descartável do GitHub Actions; cria papéis globais.
RUN_POSTGRES_ROLE_FIXTURES=
DATABASE_TEST_URL=
CONFIRM_POSTGRES_TEST_DB=

# Frontend
VITE_API_URL=http://localhost:3001
